# ==============================================================================
# WASEET (وسيط) - Environment Variables Configuration Template
# DO NOT commit actual secrets or credentials to source control.
# Copy this file to .env for local testing or set these variables in your hosting provider settings.
# ==============================================================================

# Google OAuth 2.0 Credentials
# Obtain from: Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials
# Authorized JavaScript Origins: http://localhost:8000 (and your production domain)
# Authorized Redirect URIs: http://localhost:8000/auth/callback (and https://your-domain.com/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Supabase Auth (if using Supabase Auth as the auth provider)
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Application URL / Redirect Configuration
APP_URL=
GOOGLE_REDIRECT_URI=/auth/callback
